+    // ---------------------------------------------------------- GS-SOS-001
+
+    /** GS-SOS-001 -- the iOS twin of the Android arm of the same name. A node
+     *  whose authority is WIRED but yields NO material may not offer an SOS:
+     *  the audited form treated "wired but empty" exactly like "unwired" and
+     *  fell through to the legacy structural shape, building a frame with a
+     *  zeroed seal and handing an unauthenticated distress call to relays.
+     *  The receiver's structural gate is NOT the control here -- the refusal
+     *  is required at the sender, before any durable hold, any C6 row and any
+     *  BLE write. */
+    func testGSSOS001AnAuthorityWithNoMaterialMayNotOfferAnUnsignedSos() throws {
+        let v = vec("accept_signed_ok_min")
+        let store = InMemoryMessageStore()
+        let journal = T38Journal()
+        let node = try composingNode(store, nil, repo: journal)
+        let authority = MissingMaterialAuthority(
+            dhPub: v.dhPub, generation: v.generation, clock: v.created, nonce: v.nonce)
+        node.sosAuthority = authority
+        var sends = 0
+        let result = node.dispatchSos(payload: t38Ascii("mayday-mayday")) { _, _ in
+            sends += 1
+            return true
+        }
+        XCTAssertEqual(sends, 0,
+            "an authority that yielded NO MATERIAL still OFFERED an unsigned SOS: a refusal is required, and the audited form built a structural frame and handed it to relays")
+        XCTAssertTrue(store.allHeldOrderedByPriority().isEmpty,
+            "nothing may be durably queued from a refused SOS")
+        XCTAssertEqual(journal.records.count, 0,
+            "and no C6 row may be recorded for a refusal")
+        XCTAssertEqual(authority.calls, 0,
+            "a refused SOS consumes no nonce: the refusal is the authority's verdict, not a skipped wiring")
+        guard case .failed(let why) = result else {
+            return XCTFail("a refusal is required, not " + String(describing: result))
+        }
+        XCTAssertTrue(why.contains("no SOS signing authority"),
+            "the refusal names the missing authority: " + why)
+    }
 }
