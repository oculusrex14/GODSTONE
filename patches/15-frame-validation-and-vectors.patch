+    // MARK: - negative: SOS structural rejection (decode!=nil, validator refuses)
+
+    func testRejectSosMissingPayloadMagicParsesButIsRefusedByValidator() {
+        let f = FrameV2.decode(data(fromHex:
+            "475302f0000102030405060708090a0b0c0d0e0fdeadbeef0c0000300004bd8868656c70"))
+        XCTAssertNotNil(f, "well-formed frame must parse at the wire layer; the SOS gate is structural, not parse-level")
+        XCTAssertEqual(SosFrameValidator.Verdict.payloadTooShort, SosFrameValidator.validate(f!))
+    }
+
+    func testRejectSosMissingFlagsParsesButIsRefusedByValidator() {
