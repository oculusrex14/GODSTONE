            v-16
            h-2
            z" />

    <!-- Left leaf -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M53,46
            c-2,-6 -8,-9 -13,-8
            c1,6 6,10 13,8z" />

    <!-- Right leaf -->
