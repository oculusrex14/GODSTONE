        android:fillColor="@color/ember"
        android:pathData="M54,74
            c-12,0 -22,-5 -22,-14
            c0,-9 10,-16 22,-16
            c12,0 22,7 22,16
            c0,9 -10,14 -22,14z" />

    <!-- Seedling stem -->
